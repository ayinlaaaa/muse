# Public base URL for this app. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string. Use a managed PostgreSQL provider for Vercel.
DATABASE_URL=postgresql://user:password@localhost:5432/muse

# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in your Spotify app.
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Generate with: openssl rand -hex 32
# Keep this stable; changing it makes existing stored Spotify tokens unreadable.
ENCRYPTION_KEY=
